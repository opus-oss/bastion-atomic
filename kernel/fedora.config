# Merged over forge.config (the device-only kernel from the NixOS build) by kernel/configure.sh.
# What changes is what Fedora Atomic and secureblue need that NixOS did not. Every line here must
# survive `make olddefconfig`; configure.sh stops the build if one doesn't.

CONFIG_LOCALVERSION="-bastion"

# --- Modules -----------------------------------------------------------------------------------
# On, so the kernel fits how Fedora Atomic is put together (dracut, depmod, a module tree under
# /usr/lib/modules) and anything not built in can still be loaded. Every driver forge's profile
# found stays built in, so nothing on the boot path is a module.
#
# secureblue boots with module.sig_enforce=1 and lockdown=confidentiality, so an unsigned module
# is refused. Each one is signed at build time with a key the build generates and then throws
# away (certs/signing_key.pem never leaves the build stage): nobody holds a key that could sign
# a module this kernel would accept later.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# forge.config set this because with no module loader nothing needed a helper. With one, the
# kernel runs modprobe for autoloading and systemd-coredump through core_pattern; a static
# helper path would quietly break both.
# CONFIG_STATIC_USERMODEHELPER is not set

# --- Boot path ---------------------------------------------------------------------------------
# Fedora's GRUB starts the kernel through the EFI handover protocol. forge booted through
# systemd-boot, which loads the EFI stub directly, so forge.config never needed it and has it off;
# without it GRUB refuses the kernel before the LUKS prompt.
CONFIG_EFI_HANDOVER_PROTOCOL=y
# /boot is ext4, and SELinux refuses to mount a filesystem it cannot label: without SECURITY,
# "SELinux: (dev nvme0n1p2, type ext4) has no security xattr handler", /boot fails, and
# local-fs.target sends the boot to emergency mode. AppArmor never needed the xattrs, so
# forge.config had them off.
CONFIG_EXT4_FS_SECURITY=y
CONFIG_EXT4_FS_POSIX_ACL=y
# The root filesystem is btrfs inside LUKS (forge was ext4).
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# composefs: the deployment is an EROFS image of the ostree commit, overlaid on its object store.
# SECURITY carries the SELinux labels in the image's xattrs; BACKED_BY_FILE lets it mount without
# a loop device.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_FS_VERITY=y

# Fedora's linux-firmware is xz-compressed; forge.config could only decompress zstd, so every
# firmware load (GPU, Wi-Fi, audio) would fail.
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- What the rest of Fedora uses --------------------------------------------------------------
# Swap is zram (zram-generator), compressed with zstd.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
# systemd mounts it at boot, and Flatpak/podman use it for foreign-architecture binaries.
CONFIG_BINFMT_MISC=y

# --- LSMs --------------------------------------------------------------------------------------
# SELinux was compiled into forge's kernel but missing from CONFIG_LSM, so it never started.
# On Fedora it is the policy everything is labelled for, and secureblue's confinement is built on
# it; AppArmor is the one NixOS used, and goes.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"

# --- Drivers that probe too early when built in ------------------------------------------------
# Built-in drivers probe before the LUKS root is unlocked, so anything that needs firmware from
# the root filesystem, or another device to be up first, fails there. These are modules instead,
# loaded by udev once the root is mounted, as on secureblue's kernel.
# Bluetooth: the MT7922 needs the MediaTek part of btusb, which forge.config had off -- the
# controller timed out (Opcode 0x0c03 failed: -110) and never came up.
CONFIG_BT_HCIBTUSB=m
CONFIG_BT_HCIBTUSB_MTK=y
# The Ryzen NPU: amdnpu/1502_00/npu.sbin is on the root filesystem, not in the initramfs.
CONFIG_DRM_ACCEL_AMDXDNA=m
# USB-C port manager: "PPM init failed" when it probes ahead of the embedded controller.
CONFIG_UCSI_ACPI=m
# secureblue's modules-load.d asks for both, and they are absent rather than merely late.
CONFIG_I2C_CHARDEV=m
CONFIG_X86_MSR=m
# hidraw: fwupd updates the Framework expansion cards through it, and FIDO2 security keys need it.
# Without it those devices bind to nothing ("device has no listeners").
CONFIG_HIDRAW=y
# Intel's KVM on an AMD CPU only logs "VMX not supported" at every boot.
# CONFIG_KVM_INTEL is not set
# Two PC-speaker drivers both registering "pcspkr"; the beeper is not wanted either way.
# CONFIG_INPUT_PCSPKR is not set
# CONFIG_SND_PCSP is not set
# Firmware Performance Data Table: lets systemd-analyze report firmware and loader time again.
CONFIG_ACPI_FPDT=y

# --- CPU vulnerability mitigations ---------------------------------------------------------------
# forge.config started from allnoconfig and these never got switched on, so mitigations=auto had
# nothing to select from: spectre_v1 read "Vulnerable: ... no swapgs barriers" where secureblue's
# kernel reads "Mitigation". Most of the rest are Intel-only and stay dormant on this Ryzen; the
# kernel picks per CPU at boot, so carrying them costs nothing here.
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_ITS=y

# --- Carried from forge.config, listed so their loss fails the build -----------------------------
# These need gcc-plugin-devel in the build stage. Without it olddefconfig drops them silently and
# the kernel builds fine, just without the mitigations.
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_KSTACK_ERASE=y
