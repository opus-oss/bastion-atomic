# Merged over forge.config (the device-only kernel from the NixOS build) by kernel/configure.sh.
# What changes is what Fedora Atomic and secureblue need that NixOS did not. Every line here must
# survive `make olddefconfig`; configure.sh stops the build if one doesn't.

CONFIG_LOCALVERSION="-bastion"

# --- Modules -----------------------------------------------------------------------------------
# On, so the kernel fits how Fedora Atomic is put together (dracut, depmod, a module tree under
# /usr/lib/modules) and anything not built in can still be loaded. Every driver forge's profile
# found stays built in, so nothing on the boot path is a module.
#
# secureblue boots with module.sig_enforce=1 and lockdown=confidentiality, so an unsigned module
# is refused. Each one is signed at build time with a key the build generates and then throws
# away (certs/signing_key.pem never leaves the build stage): nobody holds a key that could sign
# a module this kernel would accept later.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"
# forge.config set this because with no module loader nothing needed a helper. With one, the
# kernel runs modprobe for autoloading and systemd-coredump through core_pattern; a static
# helper path would quietly break both.
# CONFIG_STATIC_USERMODEHELPER is not set

# --- Boot path ---------------------------------------------------------------------------------
# Fedora's GRUB starts the kernel through the EFI handover protocol. forge booted through
# systemd-boot, which loads the EFI stub directly, so forge.config never needed it and has it off;
# without it GRUB refuses the kernel before the LUKS prompt.
CONFIG_EFI_HANDOVER_PROTOCOL=y
# The root filesystem is btrfs inside LUKS (forge was ext4).
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# composefs: the deployment is an EROFS image of the ostree commit, overlaid on its object store.
# SECURITY carries the SELinux labels in the image's xattrs; BACKED_BY_FILE lets it mount without
# a loop device.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_FS_VERITY=y

# Fedora's linux-firmware is xz-compressed; forge.config could only decompress zstd, so every
# firmware load (GPU, Wi-Fi, audio) would fail.
CONFIG_FW_LOADER_COMPRESS_XZ=y

# --- What the rest of Fedora uses --------------------------------------------------------------
# Swap is zram (zram-generator), compressed with zstd.
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_CRYPTO_ZSTD=y
# systemd mounts it at boot, and Flatpak/podman use it for foreign-architecture binaries.
CONFIG_BINFMT_MISC=y

# --- LSMs --------------------------------------------------------------------------------------
# SELinux was compiled into forge's kernel but missing from CONFIG_LSM, so it never started.
# On Fedora it is the policy everything is labelled for, and secureblue's confinement is built on
# it; AppArmor is the one NixOS used, and goes.
CONFIG_SECURITY_SELINUX=y
CONFIG_SECURITY_NETWORK=y
CONFIG_AUDIT=y
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux,bpf"

# --- Carried from forge.config, listed so their loss fails the build -----------------------------
# These need gcc-plugin-devel in the build stage. Without it olddefconfig drops them silently and
# the kernel builds fine, just without the mitigations.
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_KSTACK_ERASE=y
