# The vm kernel for Ubuntu guests (ubuntu/install.sh): merged after common.config and the arch
# fragment. Ubuntu is labelled for AppArmor, not SELinux, so the LSM changes; everything else is
# the same virtual-hardware-only kernel as bastion-atomic-vm.
CONFIG_LOCALVERSION="-bastion-ubuntu"
# CONFIG_SECURITY_SELINUX is not set
CONFIG_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y
CONFIG_SECURITY_APPARMOR_HASH_DEFAULT=y
CONFIG_LSM="landlock,lockdown,yama,integrity,apparmor"
# Mainline has no kernel.apparmor_restrict_unprivileged_userns (an Ubuntu patch), so nothing would
# stop an unconfined process creating a user namespace. Back to linux-hardened's default instead:
# unprivileged user namespaces off (kernel.unprivileged_userns_clone=0). Chromium-based apps such
# as Claude Desktop fall back to their setuid chrome-sandbox.
# CONFIG_USER_NS_UNPRIVILEGED is not set
# Ubuntu's installer puts the encrypted root in LVM on LUKS.
CONFIG_DM_SNAPSHOT=m
