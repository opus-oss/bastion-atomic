# x86_64 half of the vm kernel: QEMU's q35 and i440fx machines under KVM, as libvirt and
# virt-manager build them. Merged after common.config.

CONFIG_EFI_HANDOVER_PROTOCOL=y
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_KVM_GUEST=y
CONFIG_X86_X2APIC=y
CONFIG_HPET_TIMER=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_RTC_DRV_CMOS=y
# q35 still connects its keyboard over the emulated i8042.
CONFIG_SERIO=y
CONFIG_SERIO_I8042=y
CONFIG_KEYBOARD_ATKBD=y
CONFIG_LEGACY_VSYSCALL_NONE=y
# CONFIG_X86_VSYSCALL_EMULATION is not set
# CONFIG_MODIFY_LDT_SYSCALL is not set
# CONFIG_IA32_EMULATION is not set
CONFIG_RANDOMIZE_MEMORY=y
# x86 selects PERF_EVENTS unconditionally; linux-hardened keeps it root-only.
CONFIG_SECURITY_PERF_EVENTS_RESTRICT=y
CONFIG_CPU_SUP_INTEL=y
CONFIG_CPU_SUP_AMD=y
CONFIG_CRYPTO_AES_NI_INTEL=y
# secureblue's modules-load.d asks for msr.
CONFIG_X86_MSR=m

# The guest runs on whichever CPU the host has, so every mitigation stays available.
CONFIG_CPU_MITIGATIONS=y
CONFIG_MITIGATION_PAGE_TABLE_ISOLATION=y
CONFIG_MITIGATION_RETPOLINE=y
CONFIG_MITIGATION_RETHUNK=y
CONFIG_MITIGATION_UNRET_ENTRY=y
CONFIG_MITIGATION_SRSO=y
CONFIG_MITIGATION_SPECTRE_V1=y
CONFIG_MITIGATION_SPECTRE_V2=y
CONFIG_MITIGATION_SSB=y
CONFIG_MITIGATION_RETBLEED=y
CONFIG_MITIGATION_SPECTRE_BHI=y
CONFIG_MITIGATION_GDS=y
CONFIG_MITIGATION_RFDS=y
CONFIG_MITIGATION_MDS=y
CONFIG_MITIGATION_TAA=y
CONFIG_MITIGATION_MMIO_STALE_DATA=y
CONFIG_MITIGATION_L1TF=y
CONFIG_MITIGATION_SRBDS=y
CONFIG_MITIGATION_CALL_DEPTH_TRACKING=y
CONFIG_MITIGATION_IBRS_ENTRY=y
CONFIG_MITIGATION_ITS=y
CONFIG_MITIGATION_TSA=y
