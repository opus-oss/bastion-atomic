# arm64 half of the vm kernel: QEMU's `virt` machine, as UTM (QEMU backend) and libvirt build it,
# and Apple's Virtualization framework (UTM's Apple backend). Merged after common.config.

# Platform: GICv3 with ITS for MSIs, PSCI, the generic ECAM PCIe host, PL011 serial, PL031 RTC.
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_4K_PAGES=y
CONFIG_ARM_GIC_V3=y
CONFIG_ARM_GIC_V3_ITS=y
CONFIG_ARM_PSCI_FW=y
CONFIG_PCI_HOST_GENERIC=y
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
CONFIG_RTC_DRV_PL031=y
CONFIG_RTC_DRV_EFI=y
CONFIG_ARM_SMCCC_SOC_ID=y
CONFIG_OF=y
CONFIG_ACPI=y
# QEMU's virt machine powers off through a GPIO key described in its device tree.
CONFIG_GPIOLIB=y
CONFIG_GPIO_PL061=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y

# CPU hardening: pointer authentication, and branch target identification for userspace (used
# where the host CPU has them; BTI for the kernel itself needs clang), PAN, KPTI, branch-predictor hardening, shadow call stack.
CONFIG_ARM64_PTR_AUTH=y
CONFIG_ARM64_PTR_AUTH_KERNEL=y
CONFIG_ARM64_BTI=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARM64_PAN=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_EPAN=y
CONFIG_UNMAP_KERNEL_AT_EL0=y
CONFIG_MITIGATE_SPECTRE_BRANCH_HISTORY=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_ARM64_TAGGED_ADDR_ABI=y
CONFIG_ARM64_MTE=y

# Crypto extensions for LUKS and hashing.
CONFIG_KERNEL_MODE_NEON=y
CONFIG_CRYPTO_AES_ARM64_CE_BLK=y
CONFIG_CRYPTO_GHASH_ARM64_CE=y

# No perf events: nothing on a desktop guest needs them, and they are a recurring source of kernel
# bugs. (x86 selects them unconditionally; there they stay restricted to root.)
# CONFIG_PERF_EVENTS is not set
