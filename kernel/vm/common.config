# The vm image's kernel: what a Fedora Atomic guest under QEMU/KVM needs (UTM, libvirt and
# virt-manager), and nothing for real hardware. Merged over `make allnoconfig` for the target
# architecture, then the arch fragment (arm64.config or x86_64.config) over this. Every line must
# survive `make olddefconfig`; kernel/configure.sh fails the build if one doesn't.
#
# Starting from allnoconfig means anything not listed here is absent: no wireless, no Bluetooth,
# no USB devices beyond input, no real GPUs, no exotic network protocols or filesystems. The
# modprobe.d blocklist can only stop a module loading; code that was never compiled cannot be
# reached at all.

CONFIG_LOCALVERSION="-bastion-vm"
CONFIG_64BIT=y

# EXPERT exposes the options below that are otherwise forced on (KALLSYMS, IO_URING, ...).
CONFIG_EXPERT=y

# --- Core --------------------------------------------------------------------------------------
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_AUDIT=y
CONFIG_NO_HZ_IDLE=y
CONFIG_HIGH_RES_TIMERS=y
CONFIG_PREEMPT_VOLUNTARY=y
CONFIG_TICK_CPU_ACCOUNTING=y
CONFIG_TASKSTATS=y
CONFIG_TASK_DELAY_ACCT=y
CONFIG_PSI=y
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y
CONFIG_LOG_BUF_SHIFT=17
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_ELF_CORE=y
CONFIG_MULTIUSER=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_AIO=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_CROSS_MEMORY_ATTACH=y
CONFIG_SMP=y
CONFIG_NR_CPUS=64
CONFIG_NUMA=y
CONFIG_TRANSPARENT_HUGEPAGE=y
CONFIG_SWAP=y
CONFIG_ZSWAP=y
CONFIG_KSM=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
# systemd mounts it at boot, and Flatpak/podman use it for foreign-architecture binaries.
CONFIG_BINFMT_MISC=y
CONFIG_COREDUMP=y
CONFIG_SYSFS=y
CONFIG_PROC_FS=y
CONFIG_PROC_SYSCTL=y
CONFIG_PROC_PAGE_MONITOR=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_ZSTD=y
CONFIG_RD_XZ=y
CONFIG_RD_GZIP=y
CONFIG_PANIC_TIMEOUT=0

# --- Kernel modules -------------------------------------------------------------------------
# On, as in forge's kernel, so it fits how Fedora Atomic is put together (dracut, depmod,
# secureblue's modules-load.d). Every module is signed at build time with a key the build then
# throws away, and secureblue boots with module.sig_enforce=1: nothing built later can load.
CONFIG_MODULES=y
CONFIG_MODULE_UNLOAD=y
CONFIG_MODULE_SIG=y
CONFIG_MODULE_SIG_FORCE=y
CONFIG_MODULE_SIG_ALL=y
CONFIG_MODULE_SIG_SHA512=y
CONFIG_MODULE_SIG_KEY="certs/signing_key.pem"

# --- cgroups and namespaces: systemd, Flatpak (bubblewrap), podman ------------------------------
CONFIG_CGROUPS=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_SCHED=y
CONFIG_FAIR_GROUP_SCHED=y
CONFIG_CFS_BANDWIDTH=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CGROUP_CPUACCT=y
CONFIG_CGROUP_BPF=y
CONFIG_CGROUP_MISC=y
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
# linux-hardened turns unprivileged user namespaces off by default, which leaves bubblewrap (Flatpak,
# oo7-daemon's sandbox) unable to start. secureblue decides who may create them through SELinux
# (user_namespace create), as on its own kernel; this keeps that policy in charge.
CONFIG_USER_NS_UNPRIVILEGED=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y
CONFIG_TIME_NS=y

# --- BPF: systemd's per-unit IP and device filters -----------------------------------------------
CONFIG_BPF_SYSCALL=y
CONFIG_BPF_JIT=y
CONFIG_BPF_JIT_ALWAYS_ON=y
CONFIG_BPF_UNPRIV_DEFAULT_OFF=y

# --- Hardening (from forge.config / linux-hardened) ------------------------------------------------
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_VMAP_STACK=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_STRICT_KERNEL_RWX=y
CONFIG_STRICT_MODULE_RWX=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SLAB_CANARY=y
CONFIG_SLAB_SANITIZE_VERIFY=y
CONFIG_RANDOM_KMALLOC_CACHES=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_HARDENED_USERCOPY_DEFAULT_ON=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_DEBUG_KERNEL=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_DEBUG_WX=y
# secureblue boots with slab_debug=FZ (sanity checks and red zones); it needs SLUB_DEBUG to act.
CONFIG_SLUB_DEBUG=y
CONFIG_KFENCE=y
CONFIG_KFENCE_BUG_ON_DATA_CORRUPTION=y
# Built with Clang (LLVM=1 in the Containerfile), for kCFI: every indirect call checks the type of
# its target, so a corrupted function pointer cannot jump into an arbitrary function. GCC has no
# kCFI. The cost is the gcc plugins, of which only latent_entropy has no Clang counterpart.
CONFIG_CFI=y
# KSTACK_ERASE uses Clang's stack-depth callback (Clang 21+) instead of the stackleak plugin.
CONFIG_KSTACK_ERASE=y
# Structure layout randomized per build for the structures marked for it (task_struct, cred, ...),
# so an exploit cannot hard-code field offsets.
CONFIG_RANDSTRUCT_FULL=y
# Separate kmalloc caches for allocations user space controls the size and contents of (msg_msg,
# xattrs, ...), the usual heap-spraying primitives.
CONFIG_SLAB_BUCKETS=y
# Array bounds checked where the compiler knows them; a violation traps instead of being reported.
CONFIG_UBSAN=y
CONFIG_UBSAN_TRAP=y
CONFIG_UBSAN_BOUNDS=y
# CONFIG_UBSAN_SHIFT is not set
# CONFIG_UBSAN_DIV_ZERO is not set
# CONFIG_UBSAN_UNREACHABLE is not set
# CONFIG_UBSAN_BOOL is not set
# CONFIG_UBSAN_ENUM is not set
# CONFIG_UBSAN_ALIGNMENT is not set
# Catch user pages mapped twice writable, and corrupted lists, scatterlists and notifier chains.
CONFIG_PAGE_TABLE_CHECK=y
CONFIG_PAGE_TABLE_CHECK_ENFORCED=y
CONFIG_DEBUG_LIST=y
CONFIG_DEBUG_SG=y
CONFIG_DEBUG_NOTIFIERS=y
CONFIG_DEBUG_VIRTUAL=y
# An oops leaves the kernel in an unknown state that an exploit may have caused; stop there.
CONFIG_PANIC_ON_OOPS=y
# /proc/<pid>/mem may write past page protections only for a process that has the target
# ptrace-attached, as with proc_mem.force_override=ptrace, but without depending on the karg.
CONFIG_PROC_MEM_FORCE_PTRACE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
CONFIG_SECURITY_TIOCSTI_RESTRICT=y
# No raw memory or I/O port access, no kernel image in /proc, no symbol table for exploits to
# read, no kexec, no hibernation image to tamper with, no io_uring, no userfaultfd.
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_PROC_KCORE is not set
# CONFIG_KALLSYMS is not set
# CONFIG_KEXEC is not set
# CONFIG_KEXEC_FILE is not set
# CONFIG_HIBERNATION is not set
# CONFIG_IO_URING is not set
# CONFIG_USERFAULTFD is not set
# CONFIG_LEGACY_TIOCSTI is not set
# CONFIG_COMPAT_BRK is not set
# CONFIG_COMPAT is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_KPROBES is not set
# CONFIG_FTRACE is not set
# CONFIG_PROFILING is not set
# CONFIG_UPROBES is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_X86_X32_ABI is not set
# CONFIG_USELIB is not set
# CONFIG_UEVENT_HELPER is not set
# No STATIC_USERMODEHELPER: Fedora ships no usermode-helper binary, and an empty path would stop
# the kernel's own module requests (9p and virtiofs mounts, podman's veth and bridge).
# CONFIG_STATIC_USERMODEHELPER is not set

# --- LSMs: SELinux is what Fedora and secureblue are labelled for -----------------------------------
CONFIG_SECURITY=y
CONFIG_SECURITYFS=y
CONFIG_SECURITY_NETWORK=y
CONFIG_SECURITY_PATH=y
CONFIG_SECURITY_SELINUX=y
# SELinux cannot be switched to permissive: no enforcing=0 on the command line, no setenforce 0.
# CONFIG_SECURITY_SELINUX_DEVELOP is not set
CONFIG_SECURITY_YAMA=y
CONFIG_SECURITY_LOCKDOWN_LSM=y
CONFIG_SECURITY_LOCKDOWN_LSM_EARLY=y
CONFIG_LOCK_DOWN_KERNEL_FORCE_CONFIDENTIALITY=y
CONFIG_SECURITY_LANDLOCK=y
CONFIG_INTEGRITY=y
CONFIG_LSM="landlock,lockdown,yama,integrity,selinux"
# CONFIG_SECURITY_APPARMOR is not set
CONFIG_KEYS=y
CONFIG_ENCRYPTED_KEYS=y
CONFIG_TRUSTED_KEYS=y

# --- Firmware and EFI ---------------------------------------------------------------------------
CONFIG_EFI=y
CONFIG_EFI_STUB=y
CONFIG_EFIVAR_FS=y
CONFIG_FW_LOADER=y
CONFIG_FW_LOADER_COMPRESS=y
CONFIG_FW_LOADER_COMPRESS_XZ=y
CONFIG_FW_LOADER_COMPRESS_ZSTD=y
CONFIG_DMI=y
CONFIG_DMIID=y
CONFIG_ACPI=y
CONFIG_ACPI_BUTTON=y
CONFIG_PCI=y
CONFIG_PCIEPORTBUS=y
CONFIG_PCI_MSI=y
CONFIG_HOTPLUG_PCI=y
CONFIG_HOTPLUG_PCI_PCIE=y
CONFIG_TCG_TPM=y
CONFIG_TCG_TIS=y
CONFIG_TCG_CRB=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
# secureblue's modules-load.d asks for i2c-dev; without it systemd-modules-load fails at boot.
# DRM selects the I2C core anyway (DDC); only the chardev is a module.
CONFIG_I2C=y
CONFIG_I2C_CHARDEV=m

# --- virtio: disks, network, console, input, GPU, sound, entropy, shared folders ---------------------
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BALLOON=y
CONFIG_VIRTIO_INPUT=y
CONFIG_VIRTIO_BLK=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y
CONFIG_BLK_DEV_SR=y
CONFIG_SCSI_VIRTIO=y
CONFIG_BLK_DEV_NVME=y
CONFIG_ATA=y
CONFIG_SATA_AHCI=y
CONFIG_NETDEVICES=y
CONFIG_NET_CORE=y
CONFIG_VIRTIO_NET=y
CONFIG_ETHERNET=y
# virt-manager's default card when it doesn't recognise the guest OS.
CONFIG_NET_VENDOR_INTEL=y
CONFIG_E1000E=m
# spice-vdagent and qemu-guest-agent talk to the host over virtio-serial ports.
CONFIG_TTY=y
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_UNIX98_PTYS=y
CONFIG_VIRTIO_CONSOLE=y
# UTM's Apple Virtualization backend uses vsock for the guest agent.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
# Shared folders: virtiofs (UTM's Apple backend, libvirt) and 9p (UTM's QEMU backend). Modules,
# so a VM without a share never has the code loaded.
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=m
CONFIG_NET_9P=m
CONFIG_NET_9P_VIRTIO=m
CONFIG_9P_FS=m
CONFIG_9P_FS_POSIX_ACL=y
CONFIG_9P_FS_SECURITY=y

# --- Display -------------------------------------------------------------------------------------
CONFIG_DRM=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_VIRTIO_GPU_KMS=y
# The framebuffer firmware hands over (EFI GOP, UTM's ramfb) until virtio-gpu takes the display.
CONFIG_SYSFB_SIMPLEFB=y
CONFIG_DRM_SIMPLEDRM=y
# QEMU's standard VGA (libvirt "vga", UTM's virtio-ramfb fallback).
CONFIG_DRM_BOCHS=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- Input: virtio, USB tablet and keyboard (UTM's defaults), hidraw for FIDO2 keys passed through ---
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_INPUT_MOUSE=y
CONFIG_INPUT_MOUSEDEV=y
# spice-vdagentd injects the host's pointer through /dev/uinput; without it the daemon exits
# ("Fatal uinput error") and takes clipboard sharing and display resizing with it.
CONFIG_INPUT_MISC=y
CONFIG_INPUT_UINPUT=y
CONFIG_HID_SUPPORT=y
CONFIG_HID=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_PCI=y
CONFIG_USB_XHCI_HCD=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_HID=y
CONFIG_USB_HIDDEV=y

# --- Sound: UTM defaults to Intel HDA, libvirt to ich9 HDA; virtio-snd for newer hosts ----------------
CONFIG_SOUND=y
CONFIG_SND=y
CONFIG_SND_PCI=y
CONFIG_SND_HDA_INTEL=m
# Fedora's modprobe.d loads snd-seq with snd-pcm, and fails the sound card's udev event without it.
CONFIG_SND_SEQUENCER=m
CONFIG_SND_HDA_GENERIC=m
CONFIG_SND_VIRTIO=m

# --- Real-time clock ------------------------------------------------------------------------------
CONFIG_RTC_CLASS=y
CONFIG_RTC_HCTOSYS=y

# --- Storage stack: LUKS on btrfs, ext4 /boot, vfat ESP, composefs -----------------------------------
CONFIG_BLOCK=y
CONFIG_BLK_DEV=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_BLK_DEV_DM=y
CONFIG_MD=y
CONFIG_DM_CRYPT=y
CONFIG_DM_VERITY=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_EXT4_FS_SECURITY=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
CONFIG_MISC_FILESYSTEMS=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_POSIX_ACL=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_EROFS_FS_BACKED_BY_FILE=y
CONFIG_FS_VERITY=y
CONFIG_OVERLAY_FS=y
CONFIG_VFAT_FS=y
CONFIG_FAT_DEFAULT_UTF8=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_NLS_UTF8=y
CONFIG_ISO9660_FS=m
CONFIG_JOLIET=y
CONFIG_TMPFS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_AUTOFS_FS=y
CONFIG_CONFIGFS_FS=y
CONFIG_INOTIFY_USER=y
CONFIG_DNOTIFY=y
CONFIG_FANOTIFY=y
CONFIG_QUOTA=y
CONFIG_FILE_LOCKING=y
CONFIG_EXPORTFS_BLOCK_OPS=y

# --- Networking: IPv4/6, nftables for the bastion ruleset, tun for podman's pasta ---------------------
CONFIG_NET=y
CONFIG_PACKET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
# No IPv6-in-IPv4 tunnel device (sit0) on every boot.
# CONFIG_IPV6_SIT is not set
CONFIG_IP_MULTICAST=y
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
CONFIG_SYN_COOKIES=y
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
# systemd sets fq_codel as the default qdisc.
CONFIG_NET_SCHED=y
CONFIG_NET_SCH_FQ_CODEL=y
CONFIG_NET_SCH_FQ=y
CONFIG_NETFILTER=y
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_NAT=y
CONFIG_NFT_MASQ=y
CONFIG_NF_NAT=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_TUN=y
CONFIG_VETH=m
CONFIG_BRIDGE=m
CONFIG_WIREGUARD=m
# No legacy and exotic protocols: these are absent rather than blocklisted.
# CONFIG_CFG80211 is not set
# CONFIG_BT is not set
# CONFIG_IP_SCTP is not set
# CONFIG_RDS is not set
# CONFIG_TIPC is not set
# CONFIG_ATM is not set
# CONFIG_CAN is not set

# --- Crypto: LUKS (aes-xts), dm-verity, module signatures, kernel keyring ------------------------------
CONFIG_CRYPTO=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_CBC=y
CONFIG_CRYPTO_ECB=y
CONFIG_CRYPTO_CTR=y
CONFIG_CRYPTO_GCM=y
CONFIG_CRYPTO_ESSIV=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_ZSTD=y
CONFIG_CRYPTO_LZ4=y
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y
CONFIG_CRYPTO_JITTERENTROPY=y
CONFIG_CRYPTO_DRBG_MENU=y
CONFIG_CRYPTO_DRBG_HMAC=y
