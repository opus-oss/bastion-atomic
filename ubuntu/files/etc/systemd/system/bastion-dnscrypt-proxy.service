# dnscrypt-proxy as the only resolver, on 127.0.0.1:53 and [::1]:53, with Bastion's config
# (/etc/bastion/dnscrypt-proxy.toml, the same file as files/etc/dnscrypt-proxy/dnscrypt-proxy.toml).
# Ubuntu's own units are masked: they socket-activate on 127.0.2.1 and read the package's conffile,
# which would conflict with this config on every package upgrade.
[Unit]
Description=DNS-over-HTTPS resolver (dnscrypt-proxy) on loopback
After=network.target bastion-nftables.service
Before=nss-lookup.target
Wants=nss-lookup.target

[Service]
ExecStart=/usr/sbin/dnscrypt-proxy -config /etc/bastion/dnscrypt-proxy.toml
Restart=on-failure
RestartSec=2
DynamicUser=yes
CacheDirectory=dnscrypt-proxy
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
